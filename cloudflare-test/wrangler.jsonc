{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ciao-web-app-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/healthz", "/api/*"]
  },
  "services": [
    {
      "binding": "CIAO_WEB_API",
      "service": "ciao-web-api"
    }
  ],
  "vars": {
    "CIAO_ENV": "test",
    "PREDICTION_SEASON": "2026-27"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PREDICTION_LEAGUE",
        "class_name": "PredictionLeague"
      }
    ]
  },
  "migrations": [
    {
      "tag": "prediction-league-v1",
      "new_sqlite_classes": ["PredictionLeague"]
    }
  ]
}
